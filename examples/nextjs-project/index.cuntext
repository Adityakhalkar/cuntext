NEXTJS-PROJECT v1
base=./
format=text

# Codebase context for coding agents. Load index, then only what your task needs.

goals:
  add-feature          → fragments/architecture.cuntext
  debug-issue          → fragments/patterns.cuntext
  write-tests          → fragments/testing.cuntext
  modify-styles        → fragments/styling.cuntext
  understand-data      → fragments/data-flow.cuntext

quick-ref:
  entry       app/layout.tsx
  pages       app/**/page.tsx
  components  components/
  api-routes  app/api/**/route.ts
  actions     app/actions/
  config      next.config.ts  tailwind.config.ts  prisma/schema.prisma

stack: Next.js 14 TypeScript Tailwind CSS Prisma PostgreSQL NextAuth.js
auth: session via req.auth (NextAuth) — protect server components with auth()
env: DATABASE_URL NEXTAUTH_SECRET NEXTAUTH_URL
